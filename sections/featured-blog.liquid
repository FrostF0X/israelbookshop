{%- style -%}
            .section-{{ section.id }}-padding {
            padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
            padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
            }
            .blog-section-wrapper {
            display: flex;
            column-gap: 20px;
            width:100%;
            }
       .blog-header  a.button-secondary.promo-block--button {
          color: #F05036 !important;
          font-weight: 600 !important;
      }
          .blog-header {
          display: flex;
          align-content: center;
          justify-content: space-between;
          align-items: center;
         }
            .blog-section-wrapper .owl-nav.disabled {
              display: block;
          }
          .blog-section-wrapper .owl-nav.disabled {
            position: relative;
        }
          .blog-section-wrapper .owl-dots.disabled {
              display: block !important;
          }
            .blog-page-width {
                   width: 100% !important;
                   max-width: 1250px;
                   margin: 0 auto;
               }
            .blog-section-wrapper a {
            text-decoration: none;
            }
            .blog-container-content a.button.button--secondary {
            background-color: #eee0;
            }
            .content-blog-container h2 {
            color: #0C3227;
            margin: 0px;
            }
    .blog-single-container {
        display: flex;
        border-radius: 3px;
        overflow: hidden;
        width: 100%;
        flex-direction: column;
        align-items: flex-start;
    }

            .blog-single-container img {
            border-radius: 3px;
            width:100%;
            }

  span.category-blog {
      background: #F05036;
      color: #fff;
      font-size: 15px;
      border-radius: 5px;
      padding: 4px 10px;
      margin-top: 12px;
  }
            .background-color-{{section.id}} {
            background:{{ section.settings.background_color }};
            border-radius:15px;
            }
            .blog-single-container p {
            line-height: 1.3;
            margin-top: 10px;
            font-size: 15px;
            text-align:center;
            }

        #shopify-section-template--16088303665317__09e95105-44f1-49b1-834c-3fad8e603444 h4 {
            font-size: 18px;
            margin-bottom: 4px;
            font-weight: 800;
            padding-right: 30px;
        }
          section-template--16088303665317__4c9d80f8-3f26-44f5-930f-8ebbcd59a369 {
            padding: 4% 0;
        }
        #shopify-section-template--16088303665317__4c9d80f8-3f26-44f5-930f-8ebbcd59a369 .pxs-newsletter {
            padding: 5% 0;
            margin: 0 !important;
        }
          div#shopify-section-template--16088303665317__4c9d80f8-3f26-44f5-930f-8ebbcd59a369 .form-field.newsletter-submit {
            margin-left: 0px;
        }
        div#shopify-section-template--16088303665317__4c9d80f8-3f26-44f5-930f-8ebbcd59a369 button.button-primary.mdc-ripple-surface.mdc-ripple-upgraded {
            border-top-left-radius: 0px;
            border-bottom-left-radius: 0px !important;
            border-top-right-radius: 11px !important;
            border-bottom-right-radius: 11px !important;
        }
        #shopify-section-template--16088303665317__4c9d80f8-3f26-44f5-930f-8ebbcd59a369 p {
            margin-top: 6px;
        margin-top: 6px;
            font-weight: 400;
        }

        #shopify-section-template--16088303665317__4c9d80f8-3f26-44f5-930f-8ebbcd59a369 .pxs-newsletter-text {
            margin-bottom: 24px;
        }
          #shopify-section-template--16088303665317__09e95105-44f1-49b1-834c-3fad8e603444 button.owl-prev {
            right: 45px !important;
        }
        #shopify-section-template--16088303665317__09e95105-44f1-49b1-834c-3fad8e603444 button.owl-prev, #shopify-section-template--16088303665317__09e95105-44f1-49b1-834c-3fad8e603444 button.owl-next {
            display: inline-flex;
            position: absolute;
            bottom: 0px;
            right: 0;
            align-items: flex-end;
            justify-content: flex-end;
        }
        #shopify-section-template--16088303665317__09e95105-44f1-49b1-834c-3fad8e603444 p,#shopify-section-template--16088303665317__09e95105-44f1-49b1-834c-3fad8e603444 a {
            text-align: left;
            font-size: 16px;
            font-weight: 400;
            line-height: 1.625;
            margin-bottom: 20px;
          color:#000;
          padding-right: 23px;
        }
            .blog-single-container a {
            text-decoration:none;
            }
            .blog-container-content {
            display: flex;
            align-items: center;
            justify-content: space-between;
            }
            .content-blog-container p {
            margin-top: 5px;
            }
            a.button.button--secondary:hover {
            background-position: 100%;
            color: #0C3227 !important;
            border: 1px solid #0C3227;
            border-radius: 15px;
            background-image: linear-gradient(30deg,#0C3227 50%,transparent 50%);
            }
            a.button.button--secondary {
            background-image: -webkit-linear-gradient(30deg, #c266d3 50%, transparent 50%);
            background-image: linear-gradient(30deg, transparent 50%, transparent 50%);
            background-size: 500px;
            background-repeat: no-repeat;
            border: 1px solid #0C3227;
            border-radius: 20px !important;
            min-height:40px !important;
            background-position: 0%;
            color:#0C3227 !important;
            -webkit-transition: background 300ms ease-in-out;
            transition: background 300ms ease-in-out;
            }
            @media screen and (max-width: 768px) {
              #shopify-section-template--16088303665317__09e95105-44f1-49b1-834c-3fad8e603444 button.owl-prev, #shopify-section-template--16088303665317__09e95105-44f1-49b1-834c-3fad8e603444 button.owl-next {
            display: none;
        }

            .blog-section-wrapper{
            display: grid;
            grid-template-columns: 1fr;
            row-gap: 20px;
            }
            .blog-container-content{
            display:block;
            margin-bottom: 20px;
            }
            }
            @media (min-width: 775px) and (max-width: 1180px) {
            .blog-container-content{
            display:block;
            margin-bottom: 20px;
            }
            }
            @media screen and (min-width: 750px) {
            .section-{{ section.id }}-padding {
            padding-top: {{ section.settings.padding_top }}px;
            padding-bottom: {{ section.settings.padding_bottom }}px;
            }
            }
{%- endstyle -%}
<div class="{{ section.id }} section-{{ section.id }}-padding">
  <div class="background-color-{{section.id}} blog-page-width">
    <div class="blog-header">
      {% if section.settings.blog_heading != blank %}
        <h2 class="home-section--title">{{ section.settings.blog_heading }}</h2>
        <a class="button-secondary promo-block--button" href="{{ section.settings.view-btn-link }}">
          {{- section.settings['view-btn'] -}}
        </a>
      {% endif %}
    </div>
    <div class="blog-main-container">
      <div class="blog-section-wrapper owl-blog-slider owl-carousel owl-theme">
        {%- for article in section.settings.blog.articles limit: section.settings.post_limit -%}
          <div class="item">
            <div class="blog-single-container">
              {%- if article.image -%}
                {{ article | img_url: 'master', scale: 2 | img_tag: '' }}
              {%- endif -%}
              {% if section.settings.blog != blank %}
                <span class="category-blog">{{ section.settings.blog }}</span>
              {% endif %}
              <h4>{{- article.title }}</h4>
              <p>{{ article.excerpt }}</p>
              <a class="blog-url" href="{{article.url }}">Read More ></a>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>
{% schema %}
{
"name": "Blog Featured",
"settings":[
  {
      "type": "blog",
      "id": "blog",
      "label": "Select Blog Category"
},
{
"type":"text",
"id":"blog_heading",
"label":"Blog Heading"
},
{
"id": "view-btn-link",
"type": "url",
"label": "Button URL"
},
{
"id": "view-btn",
"type": "text",
"label": "Button name"
},
{
"type": "range",
"id": "post_limit",
"min": 2,
"max": 8,
"step": 1,
"default": 4,
"label": "Post Limit"
},
{
"type": "range",
"id": "padding_top",
"min": 0,
"max": 100,
"step": 4,
"unit": "px",
"label": "padding_top",
"default": 36
},
{
"type": "range",
"id": "padding_bottom",
"min": 0,
"max": 100,
"step": 4,
"unit": "px",
"label": "padding_bottom",
"default": 36
},
{
"type":"color",
"id":"background_color",
"label":"Background Color"
}
],
"presets": [
{
"name": "Blog Featured",
"category": "ADVANCED LAYOUT"
}
]
}
{% endschema %}
{% stylesheet %}
{% endstylesheet %}
<script type="text/javascript">
  (function ($) {
    'use strict';
    $('.owl-blog-slider').owlCarousel({
        loop:true,
        margin:20,
        nav:true,
        dots:true,
        navText: ["<img src='https://cdn.shopify.com/s/files/1/0558/8860/9445/files/Vector.svg?v=1688621289'/>", "<img src='https://cdn.shopify.com/s/files/1/0558/8860/9445/files/Vector_d8eb1e9f-1636-4722-a55d-d4fc80c51005.svg?v=1688621352'/>"],
        responsive:{
            0:{
                items:1
            },
            600:{
                items:3
            },
            1000:{
                items:3
            }
        }
    })

  })(jQuery);
</script>
{% style %}
  .owl-carousel{
  display:block;
  }
  button.owl-next:hover {
  background: #fff0 !important;
  }
  button.owl-prev:hover {
  background: #fff0 !important;
  }
  .blog-main-container{
  position: relative;
  }
  .blog-main-container button span {
  opacity: 0;
  }
  .blog-main-container  button.owl-next {
  position: absolute;
  top: 0;
  right: -2%;
  bottom: 30%;
  }
  .blog-main-container  button.owl-prev {
  position: absolute;
  top: 0;
  left: -2%;
  bottom: 30%;
  }
  .blog-main-container .owl-nav {
  right: 0;
  height: 100%;
  top: 0;
  }
  .blog-main-container .owl-nav {
  display: block !important;
  }
{% endstyle %}

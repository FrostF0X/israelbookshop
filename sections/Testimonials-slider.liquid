{%- style -%}
       .section-{{ section.id }}-padding {
         padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
         padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
       }
    .testimonails-page-width .owl-dots.disabled{
      display:block;
    }
    .testimonails-block img {
      width: 50% !important;
      margin: 0 auto;
      padding-bottom: 10px;
  }
       .testimonails-page-width button.owl-prev {
         position: absolute;
         top: 0;
         left: -4%;
         bottom: 5%;
        }
       .testimonails-page-width button.owl-next {
         position: absolute;
         top: 0;
         right: -4%;
         bottom: 5%;
        }
       button.owl-prev:hover {
         background: #fff0 !important;
       }
       button.owl-next:hover {
         background: #fff0 !important;
      }
       .testimonails-page-width {
           width: 100% !important;
           max-width: 1100px;
           margin: 0 auto;
       }
       .testimonails-block {
         padding: 30px;
         border: 1px solid #CAD9DB;
         border-radius: 5px;
        }
        .testimonails-block p {
         font-size: 14px;
         line-height: 1.5;
        }
        .testimonails-block h4 {
         margin-bottom: 0;
         font-size: 14px;
        }
       .testimonails-block span {
         font-size: 14px;
         line-height: 1.5;
        }
       @media screen and (min-width: 750px) {
         .section-{{ section.id }}-padding {
           padding-top: {{ section.settings.padding_top }}px;
           padding-bottom: {{ section.settings.padding_bottom }}px;
         }
       }
{%- endstyle -%}
<div id="testimonials" class="{{ section.id }} section-{{ section.id }}-padding">
  <div class="testimonails-page-width">
    <div id="testimonails" class="testimonails-slider owl-carousel owl-theme">
      {% for block in section.blocks %}
        <div class="testimonails-block">
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy' }}
          {% endif %}
          <p>{{ block.settings.testimonails_text }}</p>
          <h4>{{ block.settings.testimonails_author }}</h4>
          <span>{{ block.settings.testimonails_postion }}</span>
        </div>
      {% endfor %}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Testimonials Slider",
  "settings": [
       {
        "type":"text",
         "id":"range-slide",
         "label":"Slide Show"
      },
      {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
     {
       "name": "Testimonails",
       "type": "Testimonails",
       "settings": [
         {
           "type":"image_picker",
           "id":"image",
           "label":"Rating"
         },
         {
           "type": "richtext",
           "id": "testimonails_text",
           "label": "Testimonails"
         },
        {
           "type": "text",
           "id": "testimonails_author",
           "label": "Author"
         },
         {
           "type": "text",
           "id": "testimonails_postion",
           "label": "Position"
         }
       ]
     }
   ],
  "presets": [
{
"name": "Testimonials Slider",
"category": "ADVANCED LAYOUT"
}
]
}
{% endschema %}
<script type="text/javascript">
  (function ($) {
    'use strict';
    $('#testimonails').owlCarousel({
        loop:true,
        margin:20,
        nav:false,
        dots:true,
        navText: ["<img src='https://cdn.shopify.com/s/files/1/0558/8860/9445/files/Button_f1583cd8-47bb-4084-88ec-6e97dde25d1c.svg?v=1688618253'/>", "<img src='https://cdn.shopify.com/s/files/1/0558/8860/9445/files/Button.svg?v=1688618129'/>"],
        responsive:{
            0:{
                items:1
            },
            600:{
                items:3
            },
            1000:{
                items:{{section.settings.range-slide}}
            }
        }
    })

  })(jQuery);
</script>

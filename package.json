{
  "name": "israelbookshop-lighthouse-analysis",
  "version": "1.0.0",
  "description": "Lighthouse analysis for israelbookshop.com",
  "main": "run-lighthouse.js",
  "scripts": {
    "analyze": "node run-lighthouse.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "optimize": "playwright test tests/e2e.spec.js && node scripts/optimize_assets.js"
  },
  "dependencies": {
    "@babel/generator": "^7.29.7",
    "@babel/parser": "^7.29.7",
    "@babel/traverse": "^7.29.7",
    "lighthouse": "^11.5.0",
    "puppeteer": "^22.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "purgecss": "^8.0.0"
  }
}
